# Copy to `.env` and fill in. `.env` is gitignored; this template is not
# (zomyra-app/.gitignore re-includes it, overriding the repo-root ignore).
#
# ⚠️ EXPO_PUBLIC_* values are INLINED INTO THE SHIPPED BUNDLE at build time.
# Anyone with the .ipa/.apk can read them. That is fine for a base URL or a
# feature flag, and never acceptable for a secret, a private key, or anything
# that grants access on its own. Secrets belong on the backend.

# Backend host — scheme and host only. Do NOT include the /v1 prefix or a
# trailing slash: the client appends /v1 itself (BE TDD §7.1, MIGRATION §5).
#   e.g. EXPO_PUBLIC_API_URL=https://api-staging.zomyra.com
#
# Leave this empty and the app serves every request from the in-process mocks
# in src/api/mock/ — which is the state O-8 leaves us in until the backend has
# a reachable URL. Filling it in is the entire switch to a real backend.
EXPO_PUBLIC_API_URL=

# Force mocks on even when EXPO_PUBLIC_API_URL is set. Useful when the backend
# is up but the endpoint you need is not. Set to 1 to enable.
EXPO_PUBLIC_API_MOCKS=
