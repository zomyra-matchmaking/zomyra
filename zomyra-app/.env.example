# Copy to `.env` and fill in. `.env` is gitignored; this template is not
# (zomyra-app/.gitignore re-includes it, overriding the repo-root ignore).
#
# ⚠️ EXPO_PUBLIC_* values are INLINED INTO THE SHIPPED BUNDLE at build time.
# Anyone with the .ipa/.apk can read them. That is fine for a base URL or a
# feature flag, and never acceptable for a secret, a private key, or anything
# that grants access on its own. Secrets belong on the backend.
#
# WHERE EACH ONE IS SET:
#   local runs (`yarn start`, `yarn ios`, `yarn android`)  ->  this .env file
#   EAS cloud builds (`yarn build:dev:*`, preview, prod)   ->  eas.json, per
#                                                             build profile
# EAS does not read .env (it is gitignored and never uploaded), so the two are
# configured separately on purpose — a local experiment cannot leak into a build.

# ---------------------------------------------------------------------------
# Which backend this build talks to. One of: mock | staging | production
# ---------------------------------------------------------------------------
# mock        No backend at all. Requests are answered in-process by
#             src/api/mock/. This is the default when unset, so a fresh clone
#             runs without any configuration.
# staging     The deployed dev/staging API (O-8). Requires EXPO_PUBLIC_API_URL.
# production  The live API. Real users, real data. Requires
#             EXPO_PUBLIC_API_URL, and mocks are refused outright.
#
# ⚠️ `staging` and `production` REFUSE TO BOOT without a URL, by design: the
# alternative is a build that silently falls back to mocks and ships fabricated
# profiles to real people.
EXPO_PUBLIC_APP_ENV=mock

# ---------------------------------------------------------------------------
# Backend host — scheme and host only.
# ---------------------------------------------------------------------------
# Do NOT include the /v1 prefix or a trailing slash: the client appends /v1
# itself (BE TDD §7.1, MIGRATION §5).
#   e.g. EXPO_PUBLIC_API_URL=https://api-staging.zomyra.com
#
# Leave empty while EXPO_PUBLIC_APP_ENV=mock.
EXPO_PUBLIC_API_URL=

# ---------------------------------------------------------------------------
# Force mocks on even when a real host is configured. Set to 1 to enable.
# ---------------------------------------------------------------------------
# Useful when staging is up but the endpoint you need is not. Ignored in
# production builds — a development switch that could reach production is a way
# to ship fixtures to real users.
EXPO_PUBLIC_API_MOCKS=

# ---------------------------------------------------------------------------
# Google Sign-In client IDs (FR-1, API-3). See MIGRATION.md §4, O-19.
# ---------------------------------------------------------------------------
# Google Cloud Console issues a SEPARATE OAuth client per platform and they are
# not interchangeable. Three exist; only two are set here:
#
#   Web application  ->  EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID below.
#                        Its id is the `aud` claim of the idToken, so it MUST be
#                        the same client the backend validates against. Sent on
#                        BOTH platforms — Android needs it to be issued a token
#                        at all, not just for offline access.
#   iOS              ->  EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID below. Bound to bundle
#                        id com.zomyra.app. `app.config.js` reverses it into the
#                        Info.plist URL scheme at BUILD time, so a build made
#                        without it genuinely cannot do Google sign-in on iOS.
#   Android          ->  nothing goes here. Android resolves its client by
#                        package name + signing-certificate SHA-1, so the client
#                        only has to EXIST in the console. Register it against
#                        the EAS keystore's SHA-1 (`eas credentials`), not your
#                        local debug keystore, or internal-distribution builds
#                        fail with DEVELOPER_ERROR (code 10).
#
# These are public values, not secrets — every shipped app that uses Google
# Sign-In contains them, and they are useless without the registered bundle id /
# package + signature. The client *secret* belongs to the backend and must never
# appear here.
#
# Leave both empty to build without Google sign-in: the button reports itself
# unavailable and the config plugin is omitted. Phone auth is unaffected.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
