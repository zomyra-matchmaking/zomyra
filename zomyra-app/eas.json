{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.19.6"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "mock",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "426431032003-15glcint4vks1jpqm7ovalp1vk8u4kjl.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "426431032003-jd98hfugf0ilg4oa14bf0bdplkmeoagd.apps.googleusercontent.com"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "https://zomyra-staging.duckdns.org",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "426431032003-15glcint4vks1jpqm7ovalp1vk8u4kjl.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "426431032003-jd98hfugf0ilg4oa14bf0bdplkmeoagd.apps.googleusercontent.com"
      }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "preview-mock": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "mock"
      }
    },
    "preview-mock-simulator": {
      "extends": "preview-mock",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production"
      }
    }
  }
}
