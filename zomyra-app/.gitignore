# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
.metro-cache/
dist/
expo-env.d.ts

# Native
# ios/ and android/ are generated by `expo prebuild` (EAS runs it in the cloud).
# They are build output, not source — regenerating beats merging them.
/ios
/android
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
# The repo-root .gitignore excludes `.env`, `.env.*` and `*.env` outright, which would
# also swallow a committed template. Module 2 needs one, so re-include it here.
!.env.example

# typescript
*.tsbuildinfo

app-example
